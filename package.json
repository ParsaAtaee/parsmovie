{
  "name": "ghoghnous-movie",
  "productName": "GhoghnousMovie",
  "description": "نرم‌افزار دسکتاپ ققنوس مووی - تماشای آنلاین فیلم و سریال",
  "author": "پارسا عطایی (Parsa Ataee)",
  "main": "electron-main.cjs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "electron electron-main.cjs",
    "electron:build": "vite build && electron-builder --win",
    "mobile:sync": "vite build && cap sync",
    "mobile:android": "vite build && cap sync android",
    "mobile:ios": "vite build && cap sync ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "com.ghoghnous.movie",
    "productName": "ققنوس مووی",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ققنوس مووی"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
